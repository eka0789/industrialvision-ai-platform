# Copy to backend/.env for local development. Do not commit real credentials.
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Synchronous SQLAlchemy URL. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./industrialvision_ai.db

# Set a unique random value (at least 32 characters) for production.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256

# Access token is short-lived; the refresh token keeps operators signed in for
# a full shift. Refresh tokens are rotated on every use and revoked on logout.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12

# Login brute-force protection (per account). Nginx also rate limits per IP.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy (set true in Docker).
TRUST_PROXY_HEADERS=false

# Comma-separated browser origins; no wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_VIDEO_BYTES=5368709120
MAX_IMAGE_PIXELS=40000000
MAX_CAMERA_CONNECTIONS=16
MAX_INFLIGHT_FRAMES_PER_CAMERA=64
EVIDENCE_ROOT=data/evidence
SAMPLE_MEDIA_DIR=data/samples

MODEL_ROOT=models
DEFAULT_ONNX_MODEL=model.onnx
ONNX_DEVICE=cpu
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
FPS_INPUT=25
DEFAULT_ANOMALY_SCORE_THRESHOLD=0.5

# Demo live feed: fabricates realistic inspections for "simulated" stations and
# broadcasts them over WS /ws/inspections/live (auto-disabled when APP_ENV=test).
# MUST be false in production; startup is refused otherwise.
DEMO_LIVE_FEED=true
DEMO_FEED_INTERVAL_SECONDS=6
