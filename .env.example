# Copy to backend/.env for local development. Do not commit real credentials.
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Synchronous SQLAlchemy URL. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./industrialvision_ai.db

# Redis event bus / worker queue. Empty = in-process bus (single-process dev
# only; /health reports the active mode). REQUIRED in production (validated at
# startup) so WebSocket fan-out and background tasks work across processes.
REDIS_URL=

# Background task transport: in-process (dev default), rq (Redis queue consumed
# by `python -m app.worker`; REQUIRED in production), or auto.
TASK_QUEUE_MODE=in-process
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY_SECONDS=1

# Set a unique random value (at least 32 characters) for production.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256

# Access token is short-lived; the refresh token keeps operators signed in for
# a full shift. Refresh tokens are rotated on every use and revoked on logout.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12

# Login brute-force protection (per account). Nginx also rate limits per IP.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy (set true in Docker).
TRUST_PROXY_HEADERS=false

# SPA session storage: body = tokens in JSON responses (API clients; default).
# cookie = httpOnly cookies + double-submit CSRF (X-CSRF-Token header on every
# unsafe method). See docs/OPERATIONS.md §7.1 for the threat model.
AUTH_TOKEN_STORAGE=body
AUTH_COOKIE_SECURE=

# Comma-separated browser origins; no wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_VIDEO_BYTES=5368709120
MAX_IMAGE_PIXELS=40000000
MAX_CAMERA_CONNECTIONS=16
MAX_INFLIGHT_FRAMES_PER_CAMERA=64
EVIDENCE_ROOT=data/evidence
SAMPLE_MEDIA_DIR=data/samples

MODEL_ROOT=models
DEFAULT_ONNX_MODEL=model.onnx
ONNX_DEVICE=cpu
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
FPS_INPUT=25
DEFAULT_ANOMALY_SCORE_THRESHOLD=0.5

# Demo live feed: fabricates realistic inspections for "simulated" stations and
# broadcasts them over WS /ws/inspections/live (auto-disabled when APP_ENV=test).
# MUST be false in production; startup is refused otherwise.
DEMO_LIVE_FEED=true
DEMO_FEED_INTERVAL_SECONDS=6

# ── Predictive Maintenance (Phase B) ────────────────────────────────────────
# Optional path to a real AI4I-format CSV; absent = documented synthetic mirror.
PDM_DATASET_CSV=data/pdm/ai4i2020.csv
# Sensor history older than this is pruned by the pdm_prune_sensor_readings task.
PDM_SENSOR_RETENTION_DAYS=180

# ── Knowledge AI (Phase C) ──────────────────────────────────────────────────
# Embedding provider: auto | local-hashing | openai | sentence-transformers.
# Without keys the labeled local-hashing fallback is used (deterministic).
RAG_EMBEDDING_PROVIDER=auto
# Answer provider: auto | mock-demo | openai | gemini. Without keys the
# deterministic extractive mock-demo answerer is used and labeled as such.
RAG_LLM_PROVIDER=auto
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MAX_UPLOAD_BYTES=26214400
RAG_TOP_K=5
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ── MLOps (Phase E) ─────────────────────────────────────────────────────────
# Optional MLflow mirror; local run directory stays the source of truth.
MLFLOW_TRACKING_URI=
# Read-only run directories scanned by the experiment browser.
TRAINING_RUNS_DIRS=training_runs,data/pdm/training_runs,data/anomaly_runs

# ── Food Division Enhancements (HACCP / ISO 22000 / BPOM & OT Bridge) ───────
# Smart Evidence Retention: 100% of FAIL/REVIEW retained for 730 days (2 years);
# PASS sampled 1-in-500 on high-speed conveyor triggers and pruned after 7 days.
EVIDENCE_PASS_SAMPLE_RATE=500
EVIDENCE_PASS_RETENTION_DAYS=7
EVIDENCE_AUDIT_RETENTION_DAYS=730

# Operational Technology (OT) Bridge for conveyor photoelectric sensor & PLC rejector
OT_DEFAULT_PROTOCOL=simulated
OT_PLC_HOST=127.0.0.1
OT_PLC_PORT=502
OT_MQTT_BROKER=
OT_REJECT_PULSE_MS=45
OT_TARGET_INFERENCE_MS=30.0
