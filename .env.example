# Copy to backend/.env for local development. Do not commit real credentials.
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Synchronous SQLAlchemy URL. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./industrialvision_ai.db

# Set a unique random value (at least 32 characters) for production.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Comma-separated browser origins; no wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_VIDEO_BYTES=5368709120
MAX_CAMERA_CONNECTIONS=16
MAX_INFLIGHT_FRAMES_PER_CAMERA=64
EVIDENCE_ROOT=data/evidence
SAMPLE_MEDIA_DIR=data/samples

DEFAULT_ONNX_MODEL=models/model.onnx
ONNX_DEVICE=cpu
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
FPS_INPUT=25
DEFAULT_ANOMALY_SCORE_THRESHOLD=0.5
